# ================================================
# mt5ai AI Council — Environment Variables
# ================================================

# --- Bridge ---
BRIDGE_URL=http://mt5-node:8900

# --- Gemini (Google AI) ---
# Option A: ใช้ ADC (gcloud auth application-default login) — ไม่ต้องใส่ key
# Option B: ใช้ API Key จาก aistudio.google.com
# GEMINI_API_KEY=AIzaSy...

# --- OpenAI / ChatGPT ---
# รับจาก: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- Telegram ---
# สร้าง Bot: @BotFather ใน Telegram → /newbot
TELEGRAM_BOT_TOKEN=1234567890:AAF...
TELEGRAM_CHAT_ID=-100...

# --- Trading Settings ---
TRADING_SYMBOL=XAUUSD
TRADING_MIN_RULE_SCORE=60
TRADING_MIN_COMBINED_SCORE=65

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/trading.db
