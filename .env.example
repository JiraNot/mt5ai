# ================================================
# mt5ai AI Council — Environment Variables
# ================================================

# --- Dashboard Security (Password Gate) ---
DASHBOARD_PASSWORD=freebuff2026

# --- Bridge Connection ---
BRIDGE_URL=http://mt5-node:8900

# --- Binance USDT-M Futures (paper by default; Testnet execution opt-in) ---
BINANCE_MODE=paper
BINANCE_BASE_URL=https://testnet.binancefuture.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TIMEOUT=10
BINANCE_SYMBOL=BTCUSDT
BINANCE_USE_WEBSOCKET=false
MARKET_DATA_VENUES=mt5,binance
# Legacy single-venue setting; use MARKET_DATA_VENUES for multi-venue runs.
MARKET_DATA_VENUE=mt5
PAPER_INITIAL_BALANCE=100000

# --- AI Council (Auth Login Mode — ไม่ต้องใช้ API Token) ---
# 1. ChatGPT / Codex:
#    ระบบจะเรียกใช้ Codex CLI ผ่านเซสชัน OAuth ที่ล็อกอินไว้แล้วใน ~/.codex/auth.json อัตโนมัติ
# 2. Gemini Bull Analyst:
#    ระบบจะใช้ Google ADC (Application Default Credentials)
#    ล็อกอินครั้งเดียวผ่านคำสั่ง: gcloud auth application-default login
# 3. DeepSeek Bull Analyst (recommended fallback for Gemini):
#    Set an OpenRouter key in Coolify. When present, DeepSeek is used as the
#    Bull analyst through the OpenRouter-compatible chat API.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://trade.onetapweb.com
OPENROUTER_APP_NAME=Freebuff Trading
OPENROUTER_MODEL_CONFIG_PATH=/app/data/openrouter_model.json

# --- Telegram Alert (แจ้งเตือนเมื่อ AI เถียงกัน / ยิงออเดอร์) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Trading Settings ---
TRADING_SYMBOL=XAUUSD
TRADING_MIN_RULE_SCORE=60
TRADING_MIN_COMBINED_SCORE=65

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///app/data/freebuff.db
DATABASE_URL_SYNC=sqlite:////app/data/freebuff.db
