# ================================================
# Binance Trading Platform — Environment Variables
# ================================================

# --- Dashboard Security (Password Gate) ---
DASHBOARD_PASSWORD=freebuff2026

# --- Binance USDT-M Futures (paper by default; Testnet execution opt-in) ---
BINANCE_MODE=paper
BINANCE_BASE_URL=https://testnet.binancefuture.com
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=
# Legacy BINANCE_API_KEY / BINANCE_API_SECRET are accepted as Demo/Testnet keys.
BINANCE_TIMEOUT=10
BINANCE_SYMBOL=BTCUSDT
BINANCE_USE_WEBSOCKET=false
PAPER_INITIAL_BALANCE=100000

# --- AI Council ---
# ตั้งค่า Codex/ChatGPT, Gemini/Antigravity และ OpenRouter/DeepSeek ใน
# Dashboard > Controls & Safety > AI provider settings หลังเริ่มระบบ
# Secret จะเก็บเข้ารหัสใน /app/data/provider_settings.json และไม่ต้องใส่ใน ENV

# --- Telegram Alert (แจ้งเตือนเมื่อ AI เถียงกัน / ยิงออเดอร์) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Trading Settings ---
TRADING_SYMBOL=BTCUSDT
TRADING_MIN_RULE_SCORE=60
TRADING_MIN_COMBINED_SCORE=65

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///app/data/freebuff.db
DATABASE_URL_SYNC=sqlite:////app/data/freebuff.db
