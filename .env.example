[TEMPLATE]
# MT5 Connection
MT5_LOGIN=your_login
MT5_PASSWORD=your_password
MT5_SERVER=your_server
MT5_TIMEOUT=10000

# MT5 connection mode:
#   local  = MetaTrader5 package on this machine (Windows or Wine)
#   bridge = remote Windows bridge server hosting the MT5 terminal
MT5_MODE=local
BRIDGE_URL=http://127.0.0.1:8900
BRIDGE_TOKEN=
BRIDGE_TIMEOUT=10

# Database
DATABASE_URL=postgresql+asyncpg://freebuff:password@localhost:5432/freebuff

# Redis
REDIS_URL=redis://localhost:6379/0

# Trading
TRADING_MODE=paper
SYMBOLS=XAUUSD
PRIMARY_SYMBOL=XAUUSD

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Dashboard
DASHBOARD_PORT=8501
API_PORT=8000
